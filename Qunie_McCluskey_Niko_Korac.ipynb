    "                raise ValueError(f\"Greška: Broj {m} ne može biti istovremeno minterm i don't care!\")\n",
    "\n",
    "    def calculate_num_vars():\n",
    "        \"\"\"Izračunava minimalni broj varijabli potreban za prikaz svih minterma.\"\"\"\n",
    "        max_idx = 0\n",
    "        for m in minterms:\n",
